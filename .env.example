# MindCanvas 配置 —— 复制为 .env 后修改。所有项都有默认值，最少只改密码即可。

# 宿主机端口（容器内固定 8080）
HOST_PORT=8080

# 首次启动 seed 的账号密码（之后可在 /admin → 用户管理 修改）
MINDCANVAS_ADMIN_PASSWORD=change-me-admin
MINDCANVAS_SPEAKER_PASSWORD=change-me-speaker

# ── 综合引擎（LLM）──────────────────────────────────────────
# 可留空：启动为「启发式」降级模式，运行后在 /admin 配置 key 并持久化保存。
# 也可在此直接注入（运行时环境变量，不会写进镜像层）。
BIGMODEL_API_KEY=
# 自定义端点（内网 LLM 网关，OpenAI 兼容）。留空=默认 open.bigmodel.cn
BIGMODEL_BASE_URL=
MINDCANVAS_MODEL=glm-5.1
MINDCANVAS_ASR_MODEL=glm-asr
# 切 Anthropic 时用：
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# ── 资料补充来源：web | local | api | custom | off ────────────
# web=GLM 联网检索；local=离线本地文件检索；api=内网检索接口（含自带的 search-service）；
# custom=客户自定义检索（改 server/search-custom.js）；off=关闭
MINDCANVAS_SEARCH_MODE=web
# local 模式：把 txt/md 放进 /data/docs，或用 tools/index_docs.py 生成索引到 /data/docs-index.json
# MINDCANVAS_DOCS_DIR=/data/docs
# MINDCANVAS_DOCS_INDEX=/data/docs-index.json
# api 模式：调内网检索 HTTP 接口（适配/字段映射见 server/searchapi.js）
# MINDCANVAS_SEARCH_API_URL=http://intranet-search.local/search
# MINDCANVAS_SEARCH_API_KEY=
# MINDCANVAS_SEARCH_API_METHOD=POST

# ── 幻灯片视觉 OCR：留空=开启；off=关闭（无视觉模型的内网）────────
# MINDCANVAS_VISION=off
